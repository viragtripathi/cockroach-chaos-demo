# Copy to .env to override defaults. Everything here is optional.

# Preset that ./run.sh up starts (see presets/). Override per run with --preset NAME.
# PRESET=aws

# Deployment model: multi-region (default) or single-region (the preset's primary region, one node per zone).
# Override per run with --model single-region.
# DEPLOYMENT_MODEL=multi-region

# CockroachDB version for new clusters (a preset can pin its own).
# CRDB_VERSION=v26.3.2

# Port for the stage and API.
# PANEL_PORT=8088

# Change if 10.77.0.0/16 collides with a VPN or another network. Must be an IPv4 /16.
# CHAOS_SUBNET=10.77.0.0/16

# CockroachDB license key. Without one, CockroachDB throttles a multi-node cluster to 5 open transactions 7 days
# after it was built, and Payments start failing. Free and 30-day trial keys: CockroachDB Cloud Console,
# Organization > Enterprise Licenses. Applied when the cluster is built and every time the panel starts, so adding it
# later needs only ./run.sh up, not a rebuild. CRDB_ORG is only needed for older keys.
# CRDB_LICENSE=
# CRDB_ORG=

# Docker socket. Docker Desktop, and Podman with the /var/run/docker.sock symlink, need nothing here.
# Podman on macOS without the symlink:
# DOCKER_SOCKET=/Users/yourusername/.local/share/containers/podman/machine/podman.sock
# Podman on Linux (replace 502 with the output of `id -u`):
# DOCKER_SOCKET=/run/user/502/podman/podman.sock

# Optional: require a token for every change (chaos, rebuild, booth settings). Open /presenter?token=VALUE once
# per browser to unlock it. Set this whenever the panel is reachable from shared Wi-Fi.
# CONTROL_TOKEN=

# Optional: token for hardware triggers (POST /api/triggers/{id} with header X-Trigger-Token).
# TRIGGER_TOKEN=
